meta {
  name: POST-auth-signin-praticien
  type: http
  seq: 2
}

post {
  url: {{API_SRC}}/auth/signin
  body: json
  auth: none
}

body:json {
  {
    "email": "{{praticienEmail}}",
    "password": "{{praticienPassword}}"
  }
}

script:post-response {
  let body = res.getBody();
  bru.setEnvVar("accessToken", body.data.attributes.accessToken);
  bru.setEnvVar("refreshToken", body.data.attributes.refreshToken);
  if (body.data.attributes.profile?.id) {
    bru.setEnvVar("profileId", body.data.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
