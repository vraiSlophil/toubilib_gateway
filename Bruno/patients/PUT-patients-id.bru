meta {
  name: PUT-patients-id
  type: http
  seq: 4
}

put {
  url: {{API_SRC}}/patients/{{patientId}}
  body: json
  auth: inherit
}

body:json {
  {
    "nom": "Dupont",
    "prenom": "Marie",
    "dateNaissance": "1990-06-12",
    "adresse": "14 rue de la Paix",
    "codePostal": "54000",
    "ville": "Nancy",
    "telephone": "0611223344",
    "email": "{{patientEmail}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
