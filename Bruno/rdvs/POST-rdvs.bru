meta {
  name: POST-rdvs
  type: http
  seq: 3
}

post {
  url: {{API_SRC}}/rdvs
  body: json
  auth: inherit
}

body:json {
  {
    "praticienId": "{{praticienId}}",
    "patientId": "{{patientEmail}}",
    "debut": "2026-02-12T14:30:00+00:00",
    "dureeMinutes": 10,
    "motifVisite": "Imagerie médicale"
  }
}

script:post-response {
  let body = res.getBody();
  let rdvId = body.data?.id || body.data?.attributes?.id || body.data?.rdv_id;
  if (rdvId) {
    bru.setEnvVar("rdvId", rdvId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
