meta {
  name: POST-rdvs
  type: http
  seq: 3
}

post {
  url: {{API_SRC}}/rdvs
  body: json
  auth: inherit
}

body:json {
  {
    "praticienId": "{{praticienId}}",
    "debut": "2026-01-19T17:00:00",
    "dureeMinutes": 30,
    "motifVisite": "Imagerie médicale"
  }
}

script:post-response {
  let body = res.getBody();
  if (body.data?.rdv_id) {
    bru.setEnvVar("rdvId", body.data.rdv_id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
