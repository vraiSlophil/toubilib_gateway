meta {
  name: POST-rdvs
  type: http
  seq: 3
}

post {
  url: {{API_SRC}}/rdvs
  body: json
  auth: inherit
}

body:json {
  {
    "praticienId": "9f9b8b31-897e-4ff0-89ff-052100b35f94",
    "debut": "2026-12-22T14:10:00+00:00",
    "dureeMinutes": 10,
    "motifVisite": "Imagerie médicale"
  }
}

script:post-response {
  let body = res.getBody();
  let rdvId = body.data?.id || body.data?.attributes?.id || body.data?.rdv_id;
  if (rdvId) {
    bru.setEnvVar("rdvId", rdvId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
