## ================== Database Configurations ==================

# Praticiens
PRAT_DRIVER=pgsql
PRAT_USERNAME=toubiprat
PRAT_PASSWORD=toubiprat
PRAT_HOST=toubiprati.db
PRAT_DATABASE=toubiprat

# Patients
PAT_DRIVER=pgsql
PAT_USERNAME=toubipat
PAT_PASSWORD=toubipat
PAT_HOST=toubipat.db
PAT_DATABASE=toubipat

# Auth
AUTH_DRIVER=pgsql
AUTH_USERNAME=toubiauth
AUTH_PASSWORD=toubiauth
AUTH_HOST=toubiauth.db
AUTH_DATABASE=toubiauth

# RDV
RDV_DRIVER=pgsql
RDV_USERNAME=toubirdv
RDV_PASSWORD=toubirdv
RDV_HOST=toubirdv.db
RDV_DATABASE=toubirdv

## ================== CORS ==================
CORS_ORIGINS=0.0.0.0,localhost,localhost:3000,localhost:6080
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=X-Requested-With,Content-Type,Accept,Origin,Authorization
CORS_CREDENTIALS=false
CORS_EXPOSED_HEADERS=Location
CORS_MAX_AGE=86400

## ================== JWT =================
JWT_SECRET=secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800


## ================== Microservices HTTP ==================
PRATICIENS_API_BASE_URI=http://api.praticiens:80/api/
PATIENTS_API_BASE_URI=http://api.patients:80/api/

## ================== RabbitMQ ==================
RABBITMQ_MAILER_HOST=rabbitmq
RABBITMQ_MAILER_PORT=5672
RABBITMQ_MAILER_USER=toubi
RABBITMQ_MAILER_PASS=toubi
RABBITMQ_MAILER_VHOST=/

## ================== RabbitMQ Mail Queues/Exchanges ==================
RABBITMQ_EXCHANGE=rdv.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_ROUTING_KEY_MAIL_CREATED=rdv.created
RABBITMQ_ROUTING_KEY_MAIL_CANCELLED=rdv.cancelled
RABBITMQ_QUEUE=notif.mail
RABBITMQ_QUEUE_DURABLE=false
RABBITMQ_BINDINGS=rdv.created,rdv.cancelled
RABBITMQ_PREFETCH=1
RABBITMQ_HEARTBEAT=30
RABBITMQ_RECONNECT_DELAY=5
RABBITMQ_CONNECTION_TIMEOUT=3
RABBITMQ_READ_WRITE_TIMEOUT=3

## ================== Mailer Consumer ==================
MAILER_LOG_PATH=var/logs/mailer-consumer.log
